import pandas as pd
import numpy as np
import sqlite3 

champ_read = pd.read_csv("League of Legends Ranked Match Data  Season 15 (EUN).csv")
champ_data = pd.DataFrame(champ_read)
column_names = list(champ_read.columns)
names_list = champ_data['champion_name'].unique()
role_list = champ_data['position'].unique()
matchup_count = champ_data['game_id'].nunique()
#print(matchup_count)

top = champ_data[champ_data['position'] == 'TOP']
counts = top['game_id'].value_counts()
repeated_top_ids = set(counts[counts == 2].index)

top_repeated = top[top["game_id"].isin(repeated_top_ids)]

champion = input("Enter the champion you want to analyze: ")
if champion not in names_list:
    print("Champion not found. Please enter a valid champion name.")
    champion = input("Enter the champion you want to analyze: ")

con = sqlite3.connect(":memory:")
champ_read.to_sql("ranked_match_data", con, index=False, if_exists="replace")

query = """
SELECT *
FROM ranked_match_data
WHERE game_id IN (SELECT game_id FROM ranked_match_data WHERE position = 'TOP')
"""
df1 = pd.read_sql_query(query, con)

query2 = """
SELECT a.champion_name,
       b.champion_name AS champion_name_opp,
       AVG(a.win) AS win_rate,
       COUNT(*) AS games
FROM ranked_match_data a
JOIN ranked_match_data b
ON a.game_id = b.game_id
AND a.position = b.position
WHERE a.position = 'TOP' 
AND a.champion_name != b.champion_name
AND a.champion_name = ?
GROUP BY a.champion_name, b.champion_name
"""
df2 = pd.read_sql_query(query2, con, params=[champion])
print(df2)




